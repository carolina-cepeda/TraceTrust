// Generated by TraceTrust. PostgreSQL remains the source of truth.
// Apply schemas/tracetrust-neo4j/001_constraints.cypher first.

UNWIND $nodes AS node
MERGE (n:TraceNode {id: node.id})
SET n.node_type = node.node_type, n.label = node.label,
    n.snapshot_id = node.snapshot_id, n.properties_json = node.properties_json;

// Relationship type: ASSESSES
UNWIND $edges_ASSESSES AS edge
MATCH (source:TraceNode {id: edge.source})
MATCH (target:TraceNode {id: edge.target})
MERGE (source)-[r:ASSESSES]->(target)
SET r.properties_json = edge.properties_json;

// Relationship type: CONCERNS
UNWIND $edges_CONCERNS AS edge
MATCH (source:TraceNode {id: edge.source})
MATCH (target:TraceNode {id: edge.target})
MERGE (source)-[r:CONCERNS]->(target)
SET r.properties_json = edge.properties_json;

// Relationship type: INPUT_TO
UNWIND $edges_INPUT_TO AS edge
MATCH (source:TraceNode {id: edge.source})
MATCH (target:TraceNode {id: edge.target})
MERGE (source)-[r:INPUT_TO]->(target)
SET r.properties_json = edge.properties_json;

// Relationship type: PERFORMED_BY
UNWIND $edges_PERFORMED_BY AS edge
MATCH (source:TraceNode {id: edge.source})
MATCH (target:TraceNode {id: edge.target})
MERGE (source)-[r:PERFORMED_BY]->(target)
SET r.properties_json = edge.properties_json;

// Relationship type: PRODUCES
UNWIND $edges_PRODUCES AS edge
MATCH (source:TraceNode {id: edge.source})
MATCH (target:TraceNode {id: edge.target})
MERGE (source)-[r:PRODUCES]->(target)
SET r.properties_json = edge.properties_json;

// Relationship type: RECONCILES_WITH
UNWIND $edges_RECONCILES_WITH AS edge
MATCH (source:TraceNode {id: edge.source})
MATCH (target:TraceNode {id: edge.target})
MERGE (source)-[r:RECONCILES_WITH]->(target)
SET r.properties_json = edge.properties_json;

// Relationship type: RECORDED_BY
UNWIND $edges_RECORDED_BY AS edge
MATCH (source:TraceNode {id: edge.source})
MATCH (target:TraceNode {id: edge.target})
MERGE (source)-[r:RECORDED_BY]->(target)
SET r.properties_json = edge.properties_json;

// Relationship type: SUPPORTED_BY
UNWIND $edges_SUPPORTED_BY AS edge
MATCH (source:TraceNode {id: edge.source})
MATCH (target:TraceNode {id: edge.target})
MERGE (source)-[r:SUPPORTED_BY]->(target)
SET r.properties_json = edge.properties_json;

